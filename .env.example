# =============================================================================
# VectorForge Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local-first default. You may point this at any local or managed PostgreSQL database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vectorforge?schema=public"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Local mode avoids required cloud auth for normal desktop use.
LOCAL_AUTH_ENABLED="true"
LOCAL_USER_ID="local-user"
LOCAL_USER_EMAIL="local@local-asset-workbench.local"
LOCAL_USER_NAME="Local User"
LOCAL_OWNER_NAME="Local Owner"
LOCAL_WORKSPACE_NAME="Default Workspace"

# Optional Clerk cloud auth. Leave unset when LOCAL_AUTH_ENABLED=true.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"
CLERK_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# Redis (for BullMQ background jobs)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# File Paths (relative or absolute local paths)
# -----------------------------------------------------------------------------
UPLOAD_DIR="./uploads"
OUTPUT_DIR="./output"
BASE_ASSETS_DIR="./base-assets"
LOGS_DIR="./logs"

# -----------------------------------------------------------------------------
# Processing Defaults
# -----------------------------------------------------------------------------
DEFAULT_UPSCALE_FACTOR="2"
SMART_UPSCALE_THRESHOLD="2000"
MAX_BATCH_SIZE="50"
RASTER_EXPORT_WIDTH="2000"
RASTER_EXPORT_HEIGHT="2000"
SVG_RASTER_STROKE_WIDTH="4"
PNG_EXPORT_ARTWORK_COLOR="#000000"
PNG_WHITE_TRANSPARENCY_THRESHOLD="245"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="local-asset-workbench"
APP_DISPLAY_NAME="VectorForge"
APP_SLUG="local-asset-workbench"
APP_SOURCE_ID="local-asset-workbench"
APP_WEBSITE=""
APP_SUPPORT_EMAIL=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
