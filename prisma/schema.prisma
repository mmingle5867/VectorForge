// =============================================================================
// VectorForge - Prisma Schema
// =============================================================================
// Database: PostgreSQL. Use a local PostgreSQL DATABASE_URL for local-first operation.
// Run `npx prisma db push` or `npx prisma migrate dev` to sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User Model
// =============================================================================
// Synced from Clerk via webhook. Stores user profile data.

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  batches  Batch[]
  settings UserSettings?
  artworks Artwork[]
  owner    Owner?
  profiles SemaProfile[]

  @@map("users")
}

// =============================================================================
// UserSettings Model
// =============================================================================
// Per-user global settings for processing defaults.

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique

  // Upscaling defaults
  defaultUpscaleFactor  Int @default(2) // 1, 2, or 4
  smartUpscaleThreshold Int @default(2000) // px - upscale only if below this

  // Path configuration. Relative and absolute local paths are supported.
  baseAssetsPath String @default("./base-assets")
  outputPath     String @default("./output")

  // Default substitution variables (JSON key-value pairs)
  // Inherited by new batches as starting template
  defaultSubstitutions Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =============================================================================
// Batch Model
// =============================================================================
// Represents a single upload/processing batch.

model Batch {
  id          String  @id @default(cuid())
  userId      String
  ownerId     String?
  workspaceId String?

  // Batch metadata
  name   String? // Optional batch name/label
  status BatchStatus @default(PENDING)

  // Progress tracking
  totalItems     Int     @default(0)
  completedItems Int     @default(0)
  failedItems    Int     @default(0)
  currentItemId  String? // ID of item currently being processed

  // Processing configuration for this batch
  upscaleFactor         Int     @default(2)
  smartUpscaleThreshold Int     @default(2000)
  useBaseAssets         Boolean @default(true)

  // Substitution data for this batch (JSON key-value pairs)
  substitutionData Json @default("{}")

  // Output paths (relative)
  outputPath String?
  zipPath    String?

  // Timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BatchItem[]
  owner     Owner?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([status])
  @@map("batches")
}

// =============================================================================
// BatchItem Model
// =============================================================================
// Represents a single file within a batch.

model BatchItem {
  id          String  @id @default(cuid())
  batchId     String
  ownerId     String?
  workspaceId String?
  itemId      String?

  // File identification
  originalFilename String
  baseName         String // User-editable base name for output naming
  sequenceNumber   Int    @default(1) // For incremental naming (_001, _002)

  // SKU
  sku String? // Format: DIGI-001-[basename]-[sequencenumber]

  // Permanent identity foundation (future artwork/profile naming)
  artworkId      String?
  assetProfileId String?
  artworkNumber  String?
  profileNumber  String?

  // Processing status
  status      BatchItemStatus @default(PENDING)
  progress    Int             @default(0) // 0-100 percentage complete
  currentStep String? // e.g. "Upscaling image", "Converting with VTracer"
  errorMsg    String?

  // Image metadata
  originalWidth  Int?
  originalHeight Int?
  originalSize   Int? // bytes
  mimeType       String?

  // Upscaling
  upscaleFactor  Int     @default(2)
  upscaleApplied Boolean @default(false)
  upscaledWidth  Int?
  upscaledHeight Int?

  // File paths (relative)
  uploadPath       String? // Original uploaded file
  upscaledPath     String? // Upscaled version
  svgPath          String? // Converted SVG
  aiPath           String? // AI format (if generated)
  dxfPath          String? // DXF format (if generated)
  epsPath          String? // EPS format (if generated)
  previewPath      String? // Thumbnail preview
  outputFolderPath String? // Unzipped output folder
  zipPath          String? // ZIP file for this item
  skuFilePath      String? // Blank SKU .txt file
  metadataPath     String? // listing-info.txt

  // Processing timestamps
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  batch        Batch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  owner        Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  semaItem     Item?         @relation(fields: [itemId], references: [id], onDelete: SetNull)
  artwork      Artwork?      @relation(fields: [artworkId], references: [id], onDelete: SetNull)
  assetProfile AssetProfile? @relation(fields: [assetProfileId], references: [id], onDelete: SetNull)
  assets       Asset[]

  @@index([batchId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([itemId])
  @@index([status])
  @@index([artworkId])
  @@index([assetProfileId])
  @@map("batch_items")
}

// =============================================================================
// Permanent Numbering Models
// =============================================================================

model NumberSequence {
  id               String   @id @default(cuid())
  sequenceKey      String   @unique
  label            String
  prefix           String
  paddingLength    Int      @default(6)
  nextNumber       Int
  lastIssuedNumber Int?
  startingNumber   Int
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("number_sequences")
}

model IssuedNumber {
  id              String             @id @default(cuid())
  sequenceKey     String
  prefix          String
  numericSequence Int
  issuedNumber    String             @unique
  itemId          String?
  batchId         String?
  artworkId       String?
  assetProfileId  String?
  status          IssuedNumberStatus @default(ISSUED)
  createdAt       DateTime           @default(now())
  assignedAt      DateTime?
  voidedAt        DateTime?
  notes           String?

  @@unique([sequenceKey, numericSequence])
  @@index([itemId])
  @@index([batchId])
  @@index([artworkId])
  @@index([assetProfileId])
  @@map("issued_numbers")
}

model Artwork {
  id              String        @id @default(cuid())
  userId          String
  ownerId         String?
  workspaceId     String?
  itemId          String?
  artworkNumber   String        @unique
  numericSequence Int
  title           String
  sourceItemId    String?
  status          ArtworkStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  owner         Owner?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  item          Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)
  batchItems    BatchItem[]
  assetProfiles AssetProfile[]
  assets        Asset[]
  relationships Relationship[]

  @@index([userId])
  @@index([ownerId])
  @@index([workspaceId])
  @@index([itemId])
  @@index([status])
  @@map("artworks")
}

model AssetProfile {
  id              String             @id @default(cuid())
  artworkId       String
  profileType     AssetProfileType
  profileNumber   String             @unique
  numericSequence Int
  status          AssetProfileStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  artwork    Artwork          @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  batchItems BatchItem[]
  variants   ProductVariant[]

  @@unique([artworkId, profileType])
  @@index([status])
  @@map("asset_profiles")
}

model ProductVariant {
  id             String               @id @default(cuid())
  assetProfileId String
  sku            String               @unique
  optionData     Json                 @default("{}")
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  assetProfile AssetProfile @relation(fields: [assetProfileId], references: [id], onDelete: Cascade)

  @@index([assetProfileId])
  @@index([status])
  @@map("product_variants")
}

// =============================================================================
// SEMA Foundation Models
// =============================================================================

model Owner {
  id        String   @id @default(cuid())
  ownerId   String   @unique
  userId    String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces    Workspace[]
  items         Item[]
  artworks      Artwork[]
  assets        Asset[]
  batches       Batch[]
  batchItems    BatchItem[]
  relationships Relationship[]
  documents     Document[]

  @@map("owners")
}

model Workspace {
  id          String   @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner                Owner                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items                Item[]
  artworks             Artwork[]
  assets               Asset[]
  batches              Batch[]
  batchItems           BatchItem[]
  relationships        Relationship[]
  documents            Document[]
  storageLocations     StorageLocation[]
  categories           Category[]
  dashboardPreferences DashboardPreference[]

  @@unique([ownerId, workspaceId])
  @@index([ownerId])
  @@map("workspaces")
}

model Item {
  id          String     @id @default(cuid())
  itemId      String
  ownerId     String
  workspaceId String
  title       String
  status      ItemStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner               Owner          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artworks            Artwork[]
  assets              Asset[]
  batchItems          BatchItem[]
  relationships       Relationship[]
  categoryMemberships ItemCategory[]

  @@unique([ownerId, itemId])
  @@index([workspaceId])
  @@index([status])
  @@map("items")
}

model Asset {
  id          String      @id @default(cuid())
  assetId     String
  ownerId     String
  workspaceId String
  itemId      String
  artworkId   String
  batchItemId String?
  role        String
  filePath    String?
  mimeType    String?
  metadata    Json        @default("{}")
  status      AssetStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner               Owner                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace           Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item                Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  artwork             Artwork              @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  batchItem           BatchItem?           @relation(fields: [batchItemId], references: [id], onDelete: SetNull)
  relationshipMembers RelationshipMember[]
  versions            AssetVersion[]

  @@unique([ownerId, assetId])
  @@index([workspaceId])
  @@index([itemId])
  @@index([artworkId])
  @@index([batchItemId])
  @@index([status])
  @@map("assets")
}

model Relationship {
  id               String             @id @default(cuid())
  relationshipId   String
  relationshipType String
  ownerId          String
  workspaceId      String
  itemId           String
  artworkId        String
  bundleName       String
  metadata         Json               @default("{}")
  status           RelationshipStatus @default(ACTIVE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  owner               Owner                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace           Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  item                Item                   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  artwork             Artwork                @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  members             RelationshipMember[]
  categoryMemberships RelationshipCategory[]

  @@unique([ownerId, relationshipId])
  @@index([workspaceId])
  @@index([itemId])
  @@index([artworkId])
  @@index([relationshipType])
  @@index([status])
  @@map("relationships")
}

model RelationshipMember {
  id             String   @id @default(cuid())
  relationshipId String
  assetId        String
  sortOrder      Int
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  relationship Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  asset        Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([relationshipId, assetId])
  @@index([assetId])
  @@index([sortOrder])
  @@map("relationship_members")
}

// =============================================================================
// Document Foundation Model
// =============================================================================

model Document {
  id          String   @id @default(cuid())
  documentId  String
  ownerId     String
  workspaceId String
  title       String
  content     String
  format      String   @default("txt")
  version     Int      @default(1)
  metadata    Json     @default("{}")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner     Owner     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([ownerId, documentId])
  @@index([status])
  @@index([workspaceId])
  @@map("documents")
}

// =============================================================================
// Local Profile and Storage Foundation
// =============================================================================

model SemaProfile {
  id          String            @id @default(cuid())
  profileId   String            @unique
  userId      String
  displayName String
  isDefault   Boolean           @default(false)
  status      SemaProfileStatus @default(ACTIVE)
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user                            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageLocations                StorageLocation[]
  categories                      Category[]
  assetVersionsCreated            AssetVersion[]
  categoryAssignments             ItemCategory[]
  relationshipCategoryAssignments RelationshipCategory[]
  dashboardPreferences            DashboardPreference[]

  @@index([userId, status])
  @@index([userId, isDefault])
  @@map("sema_profiles")
}

model StorageLocation {
  id              String                @id @default(cuid())
  locationId      String                @unique
  profileId       String
  workspaceId     String?
  name            String
  kind            StorageLocationKind
  basePath        String
  isDefaultImport Boolean               @default(false)
  isReadOnly      Boolean               @default(false)
  status          StorageLocationStatus @default(ACTIVE)
  metadata        Json                  @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  profile        SemaProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspace      Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assetLocations AssetLocation[]

  @@unique([profileId, name])
  @@index([workspaceId])
  @@index([profileId, isDefaultImport])
  @@index([status])
  @@map("storage_locations")
}

// =============================================================================
// Immutable Asset Version and Location Foundation
// =============================================================================

model AssetVersion {
  id                 String             @id @default(cuid())
  assetVersionId     String             @unique
  assetId            String
  createdByProfileId String?
  versionNumber      Int
  status             AssetVersionStatus @default(DRAFT)
  sha256             String
  byteLength         BigInt
  mimeType           String?
  metadata           Json               @default("{}")
  createdAt          DateTime           @default(now())

  asset            Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdByProfile SemaProfile?    @relation(fields: [createdByProfileId], references: [id], onDelete: SetNull)
  locations        AssetLocation[]

  @@unique([assetId, versionNumber])
  @@index([createdByProfileId])
  @@index([status])
  @@index([sha256])
  @@map("asset_versions")
}

model AssetLocation {
  id                String              @id @default(cuid())
  assetVersionId    String
  storageLocationId String
  relativePath      String
  isPrimary         Boolean             @default(false)
  status            AssetLocationStatus @default(AVAILABLE)
  verifiedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  assetVersion    AssetVersion    @relation(fields: [assetVersionId], references: [id], onDelete: Restrict)
  storageLocation StorageLocation @relation(fields: [storageLocationId], references: [id], onDelete: Restrict)

  @@unique([storageLocationId, relativePath])
  @@unique([assetVersionId, storageLocationId, relativePath])
  @@index([assetVersionId, status])
  @@index([storageLocationId, status])
  @@map("asset_locations")
}

// =============================================================================
// Hierarchical Category Foundation
// =============================================================================

model Category {
  id             String            @id @default(cuid())
  categoryId     String            @unique
  profileId      String
  workspaceId    String?
  scopeType      CategoryScopeType
  scopeId        String
  parentId       String?
  parentKey      String            @default("__ROOT__")
  name           String
  normalizedName String
  sortOrder      Int               @default(0)
  status         CategoryStatus    @default(ACTIVE)
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  profile                 SemaProfile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspace               Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent                  Category?              @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children                Category[]             @relation("CategoryTree")
  itemMemberships         ItemCategory[]
  relationshipMemberships RelationshipCategory[]

  @@unique([profileId, scopeType, scopeId, parentKey, normalizedName])
  @@index([profileId, scopeType, scopeId])
  @@index([parentId, sortOrder])
  @@index([status])
  @@map("categories")
}

model ItemCategory {
  id                  String   @id @default(cuid())
  itemId              String
  categoryId          String
  assignedByProfileId String?
  isPrimary           Boolean  @default(false)
  assignedAt          DateTime @default(now())

  item              Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedByProfile SemaProfile? @relation(fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  @@unique([itemId, categoryId])
  @@index([categoryId])
  @@index([itemId, isPrimary])
  @@index([assignedByProfileId])
  @@map("item_categories")
}

model RelationshipCategory {
  id                  String   @id @default(cuid())
  relationshipId      String
  categoryId          String
  assignedByProfileId String?
  isPrimary           Boolean  @default(false)
  assignedAt          DateTime @default(now())

  relationship      Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  assignedByProfile SemaProfile? @relation(fields: [assignedByProfileId], references: [id], onDelete: SetNull)

  @@unique([relationshipId, categoryId])
  @@index([categoryId])
  @@index([relationshipId, isPrimary])
  @@index([assignedByProfileId])
  @@map("relationship_categories")
}

model DashboardPreference {
  id                  String            @id @default(cuid())
  profileId           String
  workspaceId         String?
  contextKey          String
  viewMode            DashboardViewMode @default(THUMBNAIL)
  expandedCategoryIds Json              @default("[]")
  selectedCategoryIds Json              @default("[]")
  includeDescendants  Boolean           @default(true)
  categoryMatchMode   CategoryMatchMode @default(ANY)
  filters             Json              @default("{}")
  sorting             Json              @default("[]")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  profile   SemaProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  workspace Workspace?  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([profileId, contextKey])
  @@index([workspaceId])
  @@map("dashboard_preferences")
}

// =============================================================================
// Enums
// =============================================================================

enum BatchStatus {
  PENDING
  PROCESSING
  NEEDS_MANUAL_EDIT
  READY_TO_PROCESS
  COMPLETED
  FAILED
  CANCELLED
}

enum BatchItemStatus {
  PENDING
  UPSCALING
  CONVERTING
  GENERATING_FILES
  ZIPPING
  NEEDS_MANUAL_EDIT
  READY_TO_PROCESS
  PROCESSING
  CANCELLED
  COMPLETED
  FAILED
}

enum IssuedNumberStatus {
  ISSUED
  ASSIGNED
  VOIDED
  RETIRED
}

enum ArtworkStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum AssetProfileType {
  DIGITAL
  LASER
  VINYL
  CNC
  SEWING
  PRINT
}

enum AssetProfileStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum ProductVariantStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum ItemStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum AssetStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum RelationshipStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum DocumentStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum SemaProfileStatus {
  ACTIVE
  DISABLED
  RETIRED
}

enum StorageLocationKind {
  LOCAL_FILESYSTEM
  NETWORK_FILESYSTEM
  REMOVABLE_STORAGE
  CLOUD_PROVIDER
  OTHER
}

enum StorageLocationStatus {
  ACTIVE
  UNAVAILABLE
  READ_ONLY
  RETIRED
}

enum AssetVersionStatus {
  DRAFT
  PREVIEW
  APPROVED
  RETIRED
  VOIDED
}

enum AssetLocationStatus {
  AVAILABLE
  UNAVAILABLE
  MISSING
  ARCHIVED
}

enum CategoryScopeType {
  PROFILE
  WORKSPACE
  ORGANIZATION
  PROJECT
}

enum CategoryStatus {
  ACTIVE
  RETIRED
  VOIDED
}

enum DashboardViewMode {
  LARGE_IMAGE
  THUMBNAIL
  LIST
  DETAILS
}

enum CategoryMatchMode {
  ANY
  ALL
}
